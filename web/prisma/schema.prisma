generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String // ADMIN | ANALYST | VIEWER
  displayName  String
  createdAt    DateTime @default(now())

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model IngestKey {
  id         String    @id @default(cuid())
  keyId      String    @unique // public identifier, e.g. demo-key-01 (unique index covers lookups)
  keyHash    String
  active     Boolean   @default(true)
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model Event {
  id              String   @id // event_id (client supplied, UUID)
  schemaVersion   Int      @default(1)
  eventTime       DateTime
  ingestTime      DateTime @default(now())
  sourceId        String
  sourceType      String // app|infra|system|security|synthetic
  severity        String // info|low|medium|high|critical
  category        String // auth|network|application|data|system|config|security
  message         String
  attributesJson  String   @default("{}")
  correlationId   String?
  traceId         String?
  actor           String?
  origin          String   @default("synthetic") // synthetic|external
  status          String   @default("VALIDATED") // VALIDATED|REJECTED|PROCESSED
  rejectionReason String?
  latencyMs       Int? // processing latency when processed

  @@index([eventTime])
  @@index([ingestTime])
  @@index([severity])
  @@index([category])
  @@index([sourceId])
  @@index([correlationId])
  @@index([status])
  @@index([actor])
  @@index([traceId])
  @@index([actor, eventTime])
  @@index([sourceId, eventTime])
}

model ValidationFailure {
  id            String   @id @default(cuid())
  ts            DateTime @default(now())
  sourceId      String?
  reason        String
  details       String   @default("{}")
  payloadSample String? // truncated sample (max 256 chars, no secrets)

  @@index([ts])
}

model Rule {
  id               String   @id // SG-RULE-001
  name             String
  description      String
  enabled          Boolean  @default(true)
  selectorJson     String   @default("{}")
  conditionType    String // count|ratio|sequence|exists
  threshold        Float
  windowSeconds    Int
  severity         String
  cooldownSeconds  Int    @default(300)
  suppression      Boolean @default(true)
  version          Int    @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled])
}

model RuleAudit {
  id        String   @id @default(cuid())
  ruleId    String
  actor     String
  action    String // created|updated|enabled|disabled
  changes   String   @default("{}")
  ts        DateTime @default(now())

  @@index([ruleId])
  @@index([ts])
}

model Detection {
  id          String   @id @default(cuid())
  ruleId      String
  eventId     String
  incidentId  String?
  severity    String
  score       Float
  title       String
  detailJson  String   @default("{}")
  status      String   @default("ACTIVE") // ACTIVE|SUPPRESSED
  createdAt   DateTime @default(now())

  @@index([ruleId])
  @@index([createdAt])
  @@index([incidentId])
  @@index([status])
  @@index([ruleId, status, createdAt])
}

model Incident {
  id                String    @id // INC-000001
  title             String
  severity          String
  status            String    @default("NEW") // NEW|TRIAGED|INVESTIGATING|RESOLVED|CLOSED
  ruleId            String
  correlationKey    String
  correlationLabel  String
  eventCount        Int       @default(0)
  detectionCount    Int       @default(0)
  firstEventTime    DateTime?
  lastEventTime     DateTime?
  assignedTo        String?
  resolutionSummary String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([ruleId])
  @@index([severity])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([ruleId, correlationKey, updatedAt])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  eventId    String
  late       Boolean  @default(false)
  addedAt    DateTime @default(now())

  @@unique([incidentId, eventId])
  @@index([incidentId])
}

model IncidentNote {
  id         String   @id @default(cuid())
  incidentId String
  author     String
  body       String
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

model IncidentStatusHistory {
  id         String   @id @default(cuid())
  incidentId String
  fromStatus String?
  toStatus   String
  actor      String
  note       String?
  ts         DateTime @default(now())

  @@index([incidentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  ts         DateTime @default(now())
  actor      String
  role       String
  action     String // login|logout|rule.update|incident.update|...
  targetType String?
  targetId   String?
  details    String   @default("{}")

  @@index([ts])
  @@index([actor])
  @@index([action])
}

model Metric {
  id    String @id @default(cuid())
  ts    DateTime @default(now())
  name  String
  value Float

  @@index([name, ts])
}

model MlRun {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  kind        String // EVALUATION
  modelVersion String
  seed        Int      @default(42)
  metricsJson String
  detailsJson String

  @@index([ts])
}

model LlmReport {
  id             String   @id @default(cuid())
  incidentId     String
  ts             DateTime @default(now())
  model          String
  providerStatus String
  grounded       Boolean  @default(true)
  contentJson    String
  durationMs     Int

  @@index([incidentId])
}

model Setting {
  key   String @id
  value String // JSON
}

model IncidentCounter {
  id    String @id @default("singleton")
  count Int    @default(0)
}
